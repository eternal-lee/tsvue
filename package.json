{
  "name": "@ieter/components",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "types": "es/types/index.d.ts",
  "files": [
    "es",
    "lib/**/*.css"
  ],
  "main": "es/index.umd.cjs",
  "module": "es/index.js",
  "exports": {
    ".": {
      "types": "./es/types/index.d.ts",
      "import": "./es/index.js",
      "require": "./es/index.umd.cjs"
    },
    "./index.css": "./es/assets/index.css",
    "./es/index.css": "./es/assets/index.css",
    "./es/*": "./es/*",
    "./lib/*": "./lib/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:test": "vite build --mode test",
    "build:prod": "vite build --mode production",
    "build:lib": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write --experimental-cli src/",
    "prepare": "husky"
  },
  "dependencies": {
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.23.0",
    "@rushstack/eslint-patch": "^1.8.0",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-legacy": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "cz-git": "^1.11.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-jsdoc": "^50.6.9",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-vue": "~10.6.2",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "less": "^4.2.2",
    "less-loader": "^12.2.0",
    "lint-staged": "^15.5.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.3",
    "postcss-html": "^1.8.0",
    "postcss-less": "^6.0.0",
    "prettier": "3.7.4",
    "stylelint": "^16.17.0",
    "stylelint-config-recess-order": "^6.0.0",
    "stylelint-config-recommended-vue": "^1.6.0",
    "stylelint-config-standard": "^37.0.0",
    "terser": "^5.39.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-vue-components": "^28.4.1",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-libcss": "^1.1.2",
    "vite-plugin-stylelint": "^6.0.0",
    "vue-tsc": "^3.2.2"
  },
  "lint-staged": {
    "*.{vue,js,jsx,ts,tsx}": "eslint --cache --fix",
    "*.{vue,css,less}": [
      "stylelint"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
